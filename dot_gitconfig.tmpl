[user]
  name = {{ .name }}
  email = {{ .email }}
[alias]
  co = checkout
  st = status
  sw = switch
  mergeleader = merge --no-ff --no-commit
  l = log --oneline --decorate --graph --all --abbrev-commit --pretty=format:'%C(auto)%h%Creset%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  ls = log --oneline --decorate --graph --show-signature
  la = log --oneline --decorate --graph --all
  las = log --oneline --decorate --graph --all --show-signature
  lf = log --summary --no-merges
  lfs = log --summary --no-merges --show-signature
  wtf = !git-wtf
  fixup = !sh -c 'git commit -m \"fixup! $(git log -1 --format='\\''%s'\\'' $@)\"' -
  squash = !sh -c 'git commit -m \"squash! $(git log -1 --format='\\''%s'\\'' $@)\"' -
  ri = rebase --interactive --autosquash
  rim = "!f() { base=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/@@'); [ -z \"$base\" ] && base=$(git rev-parse --verify origin/main >/dev/null 2>&1 && echo origin/main || echo origin/master); git ri --autostash \"$base\" \"$@\"; }; f"
  f = fetch --prune
  fa = fetch --all --prune --tags
  count = shortlog -sn

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
[core]
  quotepath = false
  editor = vim
[apply]
  whitespace = nowarn
[mergetool]
  keepBackup = false
[difftool]
  prompt = false
{{ if eq .chezmoi.os "darwin" -}}
# allow diffs on binary plists
[diff "plist"]
  textconv = plutil -convert xml1 -o -
{{ end -}}
[help]
  autocorrect = 1
[push]
  default = simple
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[fetch]
  prune = true
[pull]
  rebase = true
[transfer]
  fsckobjects = true

[includeIf "gitdir:~/Code/Work/"]
  path = .gitconfig-work
